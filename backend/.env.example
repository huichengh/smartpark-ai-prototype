# 园智汇 · 后端环境变量示例
#
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不要提交）
#   cp backend/.env.example backend/.env

# ---------------------------------------------------------------- 数据库
# 演示环境默认 SQLite（backend/data/smartpark.db），无需配置。
# 切到 PostgreSQL 只需改这一行（架构与 ORM 已完全兼容，无需改代码）：
# DATABASE_URL=postgresql+psycopg://smartpark:password@127.0.0.1:5432/smartpark
# DATABASE_URL=sqlite:///./data/smartpark.db

# ---------------------------------------------------------------- 安全
# 正式部署必须替换。用于签发 JWT，泄露等于所有账号可被伪造。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=smartpark-dev-secret-key-change-in-production

# ---------------------------------------------------------------- AI Agent
# rule = 本地确定性规则推理（默认，零外部依赖，演示环境使用）
# llm  = 接入大模型（需自行补齐 provider 配置）
AGENT_MODE=rule

# ---------------------------------------------------------------- 服务
# CORS 允许来源，逗号分隔；生产环境请收敛到实际域名
# CORS_ORIGINS=https://park.example.com
