# 园智汇 · 后端环境变量示例
#
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不要提交）
#   cp backend/.env.example backend/.env

# ---------------------------------------------------------------- 数据库
# 演示环境默认 SQLite（backend/data/smartpark.db），无需配置。
# 切到 PostgreSQL 只需改这一行（架构与 ORM 已完全兼容，无需改代码）：
# DATABASE_URL=postgresql+psycopg://smartpark:password@127.0.0.1:5432/smartpark
# DATABASE_URL=sqlite:///./data/smartpark.db

# ---------------------------------------------------------------- 安全
# 正式部署必须替换。用于签发 JWT，泄露等于所有账号可被伪造。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=smartpark-dev-secret-key-change-in-production

# ---------------------------------------------------------------- AI Agent
# rule = 只用本地确定性规则推理（默认，零外部依赖，离线可复现）
# auto = 优先调用大模型，失败自动回落规则（推荐：演示用这个）
# llm  = 只用大模型，失败直接报错（排查模型侧问题用）
AGENT_MODE=rule

# 大模型接入：任何 OpenAI 兼容端点都可以
# --- 本地 Ollama（先 `ollama pull qwen3.6:8b`）---
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3.6:8b
#
# --- 阿里云百炼（DashScope 兼容模式）---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=qwen3.6-flash
#
# --- 硅基流动 / 其它托管开源模型的平台 ---
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=Qwen/Qwen3.6-8B-Instruct
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6:8b
# 单次请求超时（秒）。auto 模式下超时会自动回落规则
LLM_TIMEOUT=30

# ---------------------------------------------------------------- 服务
# CORS 允许来源，逗号分隔；生产环境请收敛到实际域名
# CORS_ORIGINS=https://park.example.com
